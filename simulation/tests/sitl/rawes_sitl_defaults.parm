# rawes_sitl_defaults.parm — SITL boot-time parameter defaults for RAWES stack tests.
#
# Loaded via --add-param-file (combined with --wipe-eeprom) in _launch_sitl().
# These params become the boot defaults so setting them again via MAVLink is a
# no-op (value unchanged) — prevents EKF reinit that would delay GPS fusion.
#
# EK3_SRC1_YAW=2 (GPS dual-antenna yaw): heading from the RELPOSNED baseline
# vector between two F9P antennas 50 cm apart on the rotor disk.  Yaw is known
# from the first GPS fix — no motion, no EKFGSF rotation needed.
#
# GPS_AUTO_CONFIG=0: required for SITL RELPOSNED stream.  Without it ArduPilot
# tries to reconfigure the UBLOX chips over serial and corrupts the stream.
#
# Compass is disabled (COMPASS_USE=0) because:
#   1. The GB4008 motor swamps the magnetometer on real hardware.
#   2. SITL has 3 synthetic compasses; with dual GPS yaw they are not needed.

# Heli rate controller — tuned for the beaupoil_2026 rotor.
#
# Why these values:
#   rawes.lua flies the GUIDED *angle* path (set_target_angle_and_rate_and_
#   throttle), so this rate PID is the INNER loop beneath ArduPilot's attitude
#   P-loop (ATC_ANG_*_P).  It must track the attitude controller's rate demand
#   at the high-tilt / low-tension reel-in operating point.  The old rate-path
#   gains (P=0.02) are too weak for the angle path: crosswind drift compounds and
#   the pump blows up by cycle 2.  P=0.15 with light D=0.02 tracks tightly enough
#   to keep multi-cycle drift bounded while staying in the linear region (a
#   non-zero FLTD filters the derivative).  Validated in-process against the
#   faithful GuidedAttitudeController by test_pump_cycle_lua /
#   tests/oneoff/tune_lua_reelin.py (P>=0.10 stable, P=0.06 diverges).
#
# DataFlash logging:
#   Enable Fast Attitude (bit 0) and Fast IMU (bit 18) in addition to the
#   existing mask used by Copter heli defaults.
LOG_BITMASK       442367

#
# I-term limits stay at 0 to prevent windup during the kinematic phase
# (body held fixed; rate setpoint nonzero -> integrator races without
# IMAX cap).  Promoted by the test post-kinematic_exit if needed.
ATC_RAT_RLL_P     0.15
ATC_RAT_PIT_P     0.15
ATC_RAT_RLL_FF    0.0
ATC_RAT_PIT_FF    0.0
ATC_RAT_RLL_D     0.02
ATC_RAT_PIT_D     0.02
ATC_RAT_RLL_FLTD  10.0
ATC_RAT_PIT_FLTD  10.0
ATC_RAT_RLL_IMAX  0.0
ATC_RAT_PIT_IMAX  0.0
ATC_RAT_YAW_IMAX  0.0
ATC_ANG_RLL_P     4.0
ATC_ANG_PIT_P     6.0
ATC_ANGLE_BOOST   0      # disable throttle boost at high tilt (RAWES commands fixed throttle -> no boost wanted)

ACRO_TRAINER      0      # disable auto-leveling (physical tilt ~65 deg)

EK3_IMU_MASK    1      # bit 0 only = IMU0 only = single EKF3 core (no Roll/Pitch inconsistency)
EK3_SRC1_YAW    2      # 2=GPS dual-antenna yaw (RELPOSNED from F9P moving baseline)
EK3_MAG_CAL     0      # 0=Never
EK3_GPS_CHECK   0      # skip HDOP/speed-accuracy/min-sat checks (SITL JSON GPS has no quality fields)
EK3_POS_I_GATE  50.0   # position innovation gate (sigma) — widened for extreme attitude
EK3_VEL_I_GATE  50.0   # velocity innovation gate (sigma) — widened for extreme attitude

# Dual GPS moving-baseline heading (GPS-for-yaw in SITL)
# GPS1_TYPE=1 + GPS2_TYPE=1 (plain UBLOX): SIM_GPS2_HDG=1 injects RELPOSNED synthetically.
# Hardware uses GPS1_TYPE=17 (RTK_BASE) + GPS2_TYPE=18 (RTK_ROVER), but those require
# real serial RTCM flow which SITL does not simulate — SITL heading injection only works
# with plain UBLOX type 1 on both instances.
GPS_AUTO_CONFIG  0     # disable GPS auto-config: required in SITL to preserve RELPOSNED stream
GPS1_TYPE        17    # F9P RTK_BASE: sends RTCM corrections to GPS2
GPS2_TYPE        18    # F9P RTK_ROVER: receives RTCM, outputs RELPOSNED heading
GPS1_POS_X       0.25  # GPS1 lever arm: +25 cm along body X from hub centre
GPS2_POS_X      -0.25  # GPS2 lever arm: -25 cm along body X from hub centre
# ArduPilot 4.7 SITL param set no longer exposes SIM_GPS* position/type toggles
# used in older builds. Keep only GPS1_/GPS2_ params above for heading setup.

COMPASS_USE     0      # disable compass: GB4008 motor swamps magnetometer on hardware
COMPASS_ENABLE  0      # disable all SITL synthetic compasses
COMPASS_USE2    0      # disable compass instance 2
COMPASS_USE3    0      # disable compass instance 3
SCR_ENABLE      1      # enable Lua scripting on first boot (required for guided_nogps_armed_lua)

# Collective servo range: full 1000-2000 us so Lua's ch3 encoding maps 1:1 to servos.
# copter-heli.parm defaults to H_COL_MIN=1250/H_COL_MAX=1750 (0.5x gain).
# With full range, Lua ch3=1945 -> servo=1945 -> collective_norm=0.89 -> col_rad=0.089.
H_COL_MIN       1000   # minimum collective servo output (us) -- full range
H_COL_MAX       2000   # maximum collective servo output (us) -- full range
H_RSC_MODE      1      # 1=Passthrough: no main rotor motor (autorotation only).
                       # Motor interlock HIGH (RC8=2000) -> THROTTLE_UNLIMITED immediately.

# GB4008 anti-rotation motor -- MAIN OUT 4 (SERVO4, H_TAIL_TYPE=3 DDFP CW).
# US-convention rotor spins CCW from above => body drifts CCW (gyro:z() < 0)
# under drag.  yaw error = 0 - gyro:z() = positive => positive PID output.
# H_TAIL_TYPE=3 passes positive PID straight to SERVO4 throttle (no sign flip).
# Lua MODE_YAW bypasses this path and writes SERVO4 directly via SRV_Channels.
H_TAIL_TYPE      3     # DDFP CW: ATC_RAT_YAW PID output -> SERVO4 (no flip)
H_COL2YAW       0.0   # no collective-to-yaw feedforward
SERVO4_MIN       800   # PWM off = 800 us (motor silent)
SERVO4_MAX       2000  # PWM full = 2000 us
SERVO4_TRIM      800   # DDFP trim = off; motor silent at neutral stick

# RPM source: SITL reads rpm.rpm_1 from mediator JSON (RPM1_TYPE=10).
# On hardware: set RPM1_TYPE=5 (bidir DShot ESC telemetry) after enabling AM32 EDT.
RPM1_TYPE        10    # 10=SITL JSON field rpm.rpm_1 (mediator sends omega_spin)
RPM1_MIN         0.0   # no minimum filter
