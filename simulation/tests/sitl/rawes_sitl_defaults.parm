# rawes_sitl_defaults.parm — SITL-ONLY boot-time overrides for RAWES stack tests.
#
# This file is loaded after:
#   1) copter-heli.parm
#   2) rawes_common_defaults.parm
#
# Keep this file restricted to simulator-only settings, relaxed EKF gates for
# deterministic test startup, and test-harness behaviors not intended for
# hardware defaults.

# DataFlash logging
LOG_BITMASK       442367

EK3_IMU_MASK      1      # single EKF3 core (IMU0 only)
EK3_SRC1_YAW      2      # GPS dual-antenna yaw (moving baseline)
EK3_MAG_CAL       0      # Never

# Dual GPS moving-baseline heading (driver-side)
GPS1_TYPE         17     # F9P moving-baseline BASE
GPS2_TYPE         18     # F9P moving-baseline ROVER
GPS1_POS_X        0.25   # base lever arm
GPS2_POS_X       -0.25   # rover lever arm

# Pin EKF-assumed GPS lag deterministically.
GPS1_DELAY_MS     220
GPS2_DELAY_MS     220

COMPASS_USE       0      # disable compass yaw source
SCR_ENABLE        1      # enable Lua scripting

# Relax GPS checks / innovation gates for SITL boot determinism.
EK3_GPS_CHECK   0      # skip HDOP/speed-accuracy/min-sat checks in SITL JSON GPS
EK3_POS_I_GATE  50.0   # widened position innovation gate (sigma)
EK3_VEL_I_GATE  50.0   # widened velocity innovation gate (sigma)

# SITL moving-baseline simulator-side GPS config.
# Driver-side GPS* params live in rawes_common_defaults.parm.
GPS_AUTO_CONFIG  0      # prevent SITL auto-config from corrupting RELPOSNED stream
SIM_GPS2_ENABLE  1      # second simulated GPS required for moving baseline
SIM_GPS1_HDG     4      # simulated base antenna
SIM_GPS2_HDG     1      # simulated rover (emits RELPOSNED heading)
SIM_GPS1_POS_X   0.25   # must match GPS1_POS_X driver setting
SIM_GPS2_POS_X  -0.25   # must match GPS2_POS_X driver setting
SIM_GPS1_LAG_MS  220    # must match pinned GPS1_DELAY_MS
SIM_GPS2_LAG_MS  220    # must match pinned GPS2_DELAY_MS

# Disable synthetic SITL compasses (compass yaw source already disabled in common file).
COMPASS_ENABLE   0
COMPASS_USE2     0
COMPASS_USE3     0

# Test-harness behavior: avoid landed auto-disarm during long kinematic hold.
DISARM_DELAY     0