# rawes_common_defaults.parm — RAWES defaults shared by simtests, SITL and hardware.
#
# Loaded after copter-heli.parm and before rawes_sitl_defaults.parm.
# Keep this file free of simulator-only knobs (SIM_*, relaxed EKF gates, etc.).

# Heli rate controller — tuned for the beaupoil_2026 rotor.
#
# SINGLE SOURCE OF TRUTH: this file is the one place rate PIDs are tuned.
# Everyone -- unit tests, simtests, SITL and hardware -- loads the same
# copter-heli.parm + rawes_common_defaults.parm (+ sitl-only overlay for SITL).

# Rate PID overrides — shared tuning surface.
ATC_RAT_RLL_P    0.06
ATC_RAT_RLL_I    0.105
ATC_RAT_RLL_D    0.0001
ATC_RAT_RLL_FF   0.21
ATC_RAT_RLL_ILMI 0.1
ATC_RAT_RLL_FLTT 20
ATC_RAT_RLL_FLTE 20
ATC_RAT_RLL_FLTD 0
ATC_RAT_PIT_P    0.06
ATC_RAT_PIT_I    0.105
ATC_RAT_PIT_D    0.0001
ATC_RAT_PIT_FF   0.21
ATC_RAT_PIT_ILMI 0.1
ATC_RAT_PIT_FLTT 20
ATC_RAT_PIT_FLTE 20
ATC_RAT_PIT_FLTD 0

# disable throttle boost at high tilt
ATC_ANGLE_BOOST   0

# disable auto-leveling (physical tilt ~65 deg)
ACRO_TRAINER      0

# Collective servo range: full 1000-2000 us.
H_COL_MIN         1000
H_COL_MAX         2000
H_RSC_MODE        1      # passthrough: no main rotor motor

# GB4008 anti-rotation (yaw) motor.
# Canonical hardware wiring (read live from the Pixhawk 6C, 2026-07-08):
#   - The motor is on OUTPUT 9 (SERVO9_FUNCTION=36 = Motor4), NOT MAIN OUT 4.
#     Output 4 shares timer group TIM1 with the PWM swash servos (ch1-3), and
#     DShot is all-or-nothing per group, so the motor was relocated to a
#     DShot-capable AUX output; SERVO4 is released (FUNCTION=0).
#   - Output 9 runs bidirectional DShot so the ESC returns eRPM in-band, which
#     RPM1 consumes for omega_spin.  See the DShot block at the end of this file.
H_TAIL_TYPE       3
H_COL2YAW         0.0

# AP yaw PID off: H_YAW_TRIM is the sole yaw motor command channel.  Any nonzero
# AP yaw gain fights the Lua-owned trim and drives a limit cycle.
ATC_RAT_YAW_P     0.0
ATC_RAT_YAW_D     0.0
ATC_RAT_YAW_FLTD  10.0
ATC_RAT_YAW_I     0.0

# RAWES_* script-generated parameters (registered by rawes.lua via param:add_table).
# These are script-generated (RAWES_*) params visible in GCS, registered by rawes.lua via param:add_table.
# RAWES_MODE is set per-test; defaults here cover steady/pumping flight gains.

# RAWES_YAW_SLP: yaw motor slope override [RPM/µs].  0 -> use bench default 0.504.
# Set from bench measurement of d(shaft_RPM)/d(PWM_us) for the installed motor.
# The correct value for the GB4008 66KV + 10:1 gear is RAWES_YAW_SLP = RPM_SCALE/(GEAR_RATIO * SERVO9_SPAN_US * 2pi/60)
# (see torque_model.py for RPM_SCALE and GEAR_RATIO). Bench measurement gives 0.504 for the old 80:44 gear.
RAWES_YAW_SLP     0

# Lua steady/pumping control gains (thrust [0..1] space; AP maps thrust\u2192collective via H_COL_MIN/MAX).
RAWES_KP_ALT      0.0263
RAWES_KI_ALT      0.0026
RAWES_KD_VZ       0.105
RAWES_KP_EL       2.5     # in-plane (elevation) position rate-P gain [rad/s per m]
RAWES_KP_AZ       0.5     # crosswind (azimuth) position rate-P gain   [rad/s per m]
RAWES_KD_EL       0.0     # in-plane position rate-D gain [rad/s per (m/s)]
RAWES_CWMAX       0.6     # position rate saturation [rad/s]
RAWES_SLW         0.40    # elevation/body_z slew rate limit [rad/s]
RAWES_TEL_HZ      2.0     # diagnostic NVF telemetry emission rate [Hz]
RAWES_YFF_MAX     0.7     # yaw trim clamp upper bound [throttle fraction]
RAWES_YFF_TAU     0.3     # yaw trim low-pass time constant [s]

# --- Yaw motor output wiring + bidirectional DShot (hardware canonical) --------
# Read live from the Pixhawk 6C, 2026-07-08.  SERVO4 is released; the GB4008 yaw
# motor is Motor4 on OUTPUT 9 with a 1000-2000 us DShot range.
SERVO4_FUNCTION   0
SERVO9_FUNCTION   36
SERVO9_MIN        1000
SERVO9_MAX        2000
SERVO9_TRIM       1000
SERVO9_REVERSED   0

# BLHeli / bidirectional DShot on output 9 (bit 8 -> mask 256).
#   MASK   = DShot output channels          (256 = ch9)
#   BDMASK = bidirectional-DShot channels   (256 = ch9; returns eRPM in-band)
#   AUTO=0 -> explicit mask (not auto-derived from motor outputs)
#   OTYPE=5 -> DShot300;  DSHOT_ESC=1 -> BLHeli telemetry decode
#   POLES=22 -> ArduPilot divides eRPM by N pole-pairs for mech RPM
#   BRD_IO_DSHOT=0 -> outputs driven from the FMU, not the IO co-processor
SERVO_BLH_MASK    256
SERVO_BLH_BDMASK  256
SERVO_BLH_AUTO    0
SERVO_BLH_OTYPE   5
SERVO_BLH_POLES   22
SERVO_BLH_TRATE   10
SERVO_DSHOT_ESC   1
SERVO_DSHOT_RATE  0
BRD_IO_DSHOT      0

# ESC RPM telemetry: RPM1 sourced from the output-9 ESC (bidirectional DShot).
RPM1_TYPE         5
RPM1_ESC_MASK     256
