class TrimResult[State: QuasiStaticRotorState | PittPetersRotorState | OyeRotorState = QuasiStaticRotorState | PittPetersRotorState | OyeRotorState]:
    def __new__(cls) -> _Never: ...
    @property
    def tilt_lon(self) -> float: ...
    @property
    def tilt_lat(self) -> float: ...
    @property
    def Mx_residual(self) -> float: ...
    @property
    def My_residual(self) -> float: ...
    @property
    def iterations(self) -> int: ...
    @property
    def converged(self) -> bool: ...
    @property
    def final_state(self) -> State: ...

type _QuasiStaticModel = _QuasiStaticBEMLinear | _QuasiStaticBEMTabulated
type _PittPetersModel = _PittPetersModelLinear | _PittPetersModelTabulated
type _OyeModel = _OyeBEMModelLinear | _OyeBEMModelTabulated
type _VpmModel = _VpmRotorLinear | _VpmRotorTabulated
type _BemModel = _QuasiStaticModel | _PittPetersModel | _OyeModel
type _AeroModel = _BemModel | _VpmModel
type _BemState = QuasiStaticRotorState | PittPetersRotorState | OyeRotorState

