"""Native contracts verified against dynbem 0.8.0's PyO3 bindings."""

from collections.abc import Sequence as _Sequence
from typing import Never as _Never, Protocol as _Protocol, overload as _overload
import numpy as _np
from numpy.typing import NDArray as _NDArray

type _Array = _NDArray[_np.float64]

class _PolarProperties(_Protocol):
    @property
    def CL0(self) -> float: ...
    @property
    def CL_alpha_per_rad(self) -> float: ...
    @property
    def CD0(self) -> float: ...
    @property
    def alpha_stall_deg(self) -> float: ...

class LinearPolar:
    def __init__(self, CL0: float, CL_alpha_per_rad: float, CD0: float, alpha_stall_rad: float) -> None: ...
    @property
    def CL0(self) -> float: ...
    @property
    def CL_alpha_per_rad(self) -> float: ...
    @property
    def CD0(self) -> float: ...
    @property
    def alpha_stall_rad(self) -> float: ...
    def cl_cd(self, /, alpha_rad: float) -> tuple[float, float]: ...
    def cl_cd_arr(self, /, alpha_rad: _Array) -> tuple[_Array, _Array]: ...
    @staticmethod
    def from_properties(airfoil: _PolarProperties) -> LinearPolar: ...

class TabulatedPolar:
    def __init__(self, alpha_rad: _Array, cl: _Array, cd: _Array) -> None: ...
    def cl_cd(self, /, alpha_rad: float) -> tuple[float, float]: ...
    def cl_cd_arr(self, /, alpha_rad: _Array) -> tuple[_Array, _Array]: ...

