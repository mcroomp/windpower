{
  "python.analysis.includeExtraPathSymbolsInSymbolSearch": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.testing.pytestArgs": [
    "tests/unit",
    "tests/simtests"
  ],
  "python.analysis.exclude": [
    ".git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/__pycache__/**",
    ".mypy_cache/**",
    ".pytest_cache/**",
    ".ruff_cache/**",
    "**/simulation/logs/**",
    "**/tmp/**"
  ],
  "rust-analyzer.linkedProjects": [
    "linkhub/Cargo.toml"
  ],
  "rust-analyzer.cargo.sysroot": null,
  "rust-analyzer.cachePriming.enable": false,
  "rust-analyzer.files.excludeDirs": [
    ".git",
    ".venv",
    ".pytest_cache",
    "am32config",
    "analysis",
    "archive",
    "arduloop",
    "build",
    "calibrate",
    "design",
    "dist",
    "documents",
    "envelope",
    "felix",
    "groundstation",
    "hardware",
    "linkhub/target",
    "linkhub-ui",
    "linkhub_client",
    "presentations",
    "rawes.egg-info",
    "scripts",
    "simulation",
    "tests",
    "tmp",
    "viz3d"
  ],
  "npm.exclude": [
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/archive/**",
    "**/build/**",
    "**/dist/**",
    "**/linkhub/**",
    "**/node_modules/**",
    "**/rawes.egg-info/**",
    "**/simulation/logs/**",
    "**/target/**",
    "**/tmp/**"
  ],
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.exclude": [
    "**/.git/**",
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/archive/**",
    "**/build/**",
    "**/dist/**",
    "**/linkhub/**",
    "**/node_modules/**",
    "**/rawes.egg-info/**",
    "**/simulation/logs/**",
    "**/target/**",
    "**/tmp/**"
  ],
  "cmake.configureOnOpen": false,
  "cmake.enableAutomaticKitScan": false,
  "cmake.ctest.testExplorerIntegrationEnabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/dist": true,
    "**/build": true,
    "**/target": true,
    "**/coverage": true,
    "**/simulation/logs": true,
    "**/tmp": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/am32config/node_modules/**": true,
    "**/linkhub-ui/node_modules/**": true,
    "**/linkhub/target/**": true,
    "**/simulation/logs/**": true,
    "**/tmp/**": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/am32config/node_modules/**": true,
    "**/linkhub-ui/node_modules/**": true,
    "**/linkhub/target/**": true,
    "**/simulation/logs/**": true,
    "**/tmp/**": true
  }
}
