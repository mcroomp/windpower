{
  "include": [
    "simulation",
    "groundstation",
    "arduloop",
    "calibrate",
    "envelope",
    "analysis",
    "viz3d",
    "scripts",
    "tests",
    "linkhub_client"
  ],
  "exclude": [
    ".git",
    ".obsidian",
    "**/__pycache__",
    "**/tests/oneoff",
    "**/node_modules",
    "**/target",
    ".pytest_cache",
    ".venv",
    "archive",
    "build",
    "dist",
    "rawes.egg-info",
    "simulation/logs",
    "tmp"
  ],
  "extraPaths": [
    "linkhub_client/src"
  ],
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
